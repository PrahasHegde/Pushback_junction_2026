# Copy this file to .env and fill in your keys. Never commit .env.

# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-google-ai-studio-key
# Exa key (https://dashboard.exa.ai)
EXA_API_KEY=your-exa-key

# Optional
# PORT=8899
# GEMINI_MODEL=gemini-pro-latest              # main investigator
# GEMINI_FALLBACK_MODEL=gemini-flash-latest   # used on rate limits
# GEMINI_FAST_MODEL=gemini-flash-latest       # chat + letter rewrites
# GEMINI_TRIAGE_MODEL=gemini-flash-lite-latest  # ~2s first read
